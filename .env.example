# Copy this file to ".env" and fill in your real values. Never commit ".env" itself.

PORT=5000

# PostgreSQL connection — these match the docker-compose.yml container as-is.
# If you change the values in docker-compose.yml, update these to match.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=shipment_db
DB_USER=postgres
DB_PASSWORD=password


JWT_SECRET=abcd

#DATABASE_URL="postgresql://postgres:password@localhost:5433/shipment_db"
#DATABASE_URL=postgresql://postgres:password@postgres:5432/shipment_db